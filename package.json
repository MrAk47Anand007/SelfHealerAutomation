{
  "name": "uiheal-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/pnpm-cli.mjs -r build",
    "test": "vitest run",
    "typecheck": "node scripts/pnpm-cli.mjs -r typecheck",
    "lint:types": "node scripts/pnpm-cli.mjs typecheck",
    "verify": "node scripts/verify.mjs",
    "demo:generic": "node scripts/pnpm-cli.mjs --filter uiheal test -- cli.test.ts",
    "test:e2e:offline": "vitest run packages/cli/test/e2eOffline.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
